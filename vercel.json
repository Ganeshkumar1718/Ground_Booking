{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "client/dist" }
    },
    {
      "src": "server/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/$1.js" },
    { "src": "/(.*)", "dest": "client/dist/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "client/dist/index.html" }
  ]
}
